# AI Commit Gate — config (commit được; không chứa secret)
# Script load file này làm default. Env đã set (pre-commit / CI / shell) thắng.

# 1 = warn-only (không chặn commit). 0 = chặn chỉ khi có critical (major chỉ cảnh báo).
# Pre-commit đọc file này (không pin DEMO trong .pre-commit-config.yaml).
AI_GATE_DEMO=0

# Timeout giây cho lời gọi `claude` (fail sớm nếu treo).
AI_GATE_TIMEOUT=180

# Model Claude CLI (nhanh: haiku). Để trống nếu muốn model mặc định của CLI.
AI_GATE_MODEL=haiku

# Effort: low (nhanh) | medium | high | xhigh | max
AI_GATE_EFFORT=low

# 1 = claude --bare (cần ANTHROPIC_API_KEY; bỏ OAuth). 0 = dùng login Claude Code thường.
AI_GATE_BARE=0

# Thư mục cache theo hash diff (relative tới repo root hoặc absolute).
AI_GATE_CACHE_DIR=.git/ai-commit-gate-cache

# Thư mục ghi báo cáo markdown (latest.md + archive theo timestamp).
# Để trống để tắt ghi report.
AI_GATE_REPORT_DIR=.claude/reports/ai-commit-gate

# 1 = fail khi review unavailable / timeout (sau khi đã có claude).
# Thiếu binary `claude` luôn fail (exit 1), bất kể biến này.
AI_GATE_REQUIRE_LLM=0
